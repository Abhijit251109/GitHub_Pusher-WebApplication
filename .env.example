# Public deployment
PORT=4173
HOST=0.0.0.0
PUBLIC_BASE_URL=https://your-domain.example
TRUST_PROXY=1
COOKIE_SECURE=true
SESSION_SECRET=replace-with-a-long-random-secret
TOKEN_ENCRYPTION_KEY=64-hex-characters
SYNC_INTERVAL_MS=20000
MAX_UPLOAD_FILES=2000
MAX_FILE_SIZE_MB=50
MAX_TOTAL_UPLOAD_MB=250
MAX_SNAPSHOTS_PER_PROJECT=20
SESSION_TTL_DAYS=30

# GitHub OAuth App
GITHUB_CLIENT_ID=your-client-id
GITHUB_CLIENT_SECRET=your-client-secret
GITHUB_OAUTH_SCOPE=repo
GITHUB_CALLBACK_URL=https://your-domain.example/auth/github/callback

# Optional branding
APP_NAME=GitHub Project Pusher
