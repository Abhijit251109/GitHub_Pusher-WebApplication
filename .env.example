# Backend / Render free web service
NODE_ENV=production
PORT=10000
HOST=0.0.0.0
PUBLIC_BASE_URL=https://YOUR-RENDER-SERVICE.onrender.com
# Optional native app URL override; defaults to PUBLIC_BASE_URL.
# GPP_APP_URL=https://YOUR-RENDER-SERVICE.onrender.com
FRONTEND_URL=https://YOUR-USERNAME.github.io/YOUR-REPOSITORY
TRUST_PROXY=1
COOKIE_SECURE=true
COOKIE_SAMESITE=Lax
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
TOKEN_ENCRYPTION_KEY=64-hex-characters-or-base64-32-byte-key
SYNC_INTERVAL_MS=30000
SESSION_TTL_DAYS=7
MAX_UPLOAD_FILES=2000
MAX_FILE_SIZE_MB=50
MAX_TOTAL_UPLOAD_MB=40
MAX_ARCHIVE_MB=45
MAX_SNAPSHOTS_PER_PROJECT=10

# Supabase free persistent database + private object storage
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR-SERVER-ONLY-SUPABASE-SECRET-KEY
# Legacy name also accepted by the backend:
# SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVER-ONLY-SUPABASE-SERVICE-ROLE-KEY
SUPABASE_STORAGE_BUCKET=gpp-private

# GitHub OAuth App
GITHUB_CLIENT_ID=your-client-id
GITHUB_CLIENT_SECRET=your-client-secret
GITHUB_OAUTH_SCOPE=repo offline_access
GITHUB_CALLBACK_URL=https://YOUR-RENDER-SERVICE.onrender.com/auth/github/callback
GITHUB_ALLOW_SIGNUP=true

# Optional hard allowlist for a personal/private deployment.
REQUIRE_GITHUB_ALLOWLIST=true
ALLOWED_GITHUB_USER_IDS=YOUR_NUMERIC_GITHUB_USER_ID

# Branding
APP_NAME=GitHub Project Pusher
MAX_EXTRACTED_MB=1500
MAX_ARCHIVE_ENTRIES=10000
MAX_DECOMPRESSION_RATIO=400
