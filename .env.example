# Backend / Render free web service
NODE_ENV=production
PORT=10000
HOST=0.0.0.0
PUBLIC_BASE_URL=https://YOUR-RENDER-SERVICE.onrender.com
FRONTEND_URL=https://YOUR-USERNAME.github.io/YOUR-REPOSITORY
# Number of proxies in front of the app (1 on Render). Rate limits key on the client IP this
# reveals. "true" is refused because it lets clients spoof their IP.
TRUST_PROXY=1
COOKIE_SECURE=true
COOKIE_SAMESITE=Lax
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
TOKEN_ENCRYPTION_KEY=64-hex-characters-or-base64-32-byte-key
SYNC_INTERVAL_MS=30000
SESSION_TTL_DAYS=7
MAX_UPLOAD_FILES=20000
MAX_FILE_SIZE_MB=100
MAX_TOTAL_UPLOAD_MB=200
MAX_ARCHIVE_MB=200
MAX_SNAPSHOTS_PER_PROJECT=10

# Supabase free persistent database + private object storage
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR-SERVER-ONLY-SUPABASE-SECRET-KEY
# Legacy name also accepted by the backend:
# SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVER-ONLY-SUPABASE-SERVICE-ROLE-KEY
SUPABASE_STORAGE_BUCKET=gpp-private

# GitHub OAuth App
GITHUB_CLIENT_ID=your-client-id
GITHUB_CLIENT_SECRET=your-client-secret
# OAuth uses public_repo by default; private-repository access requires explicit user consent.
GITHUB_CALLBACK_URL=https://YOUR-RENDER-SERVICE.onrender.com/auth/github/callback
GITHUB_ALLOW_SIGNUP=true

# Optional hard allowlist for a personal/private deployment.
REQUIRE_GITHUB_ALLOWLIST=true
ALLOWED_GITHUB_USER_IDS=YOUR_NUMERIC_GITHUB_USER_ID

# Branding
APP_NAME=GitHub Pusher Studio
MAX_EXTRACTED_MB=500
MAX_ARCHIVE_ENTRIES=50000
MAX_DECOMPRESSION_RATIO=200

# Abuse limits (defaults shown). Over-limit requests get HTTP 429 without doing any work.
# Only FRONTEND_URL and PUBLIC_BASE_URL origins may call the API with credentials.
MAX_CONCURRENT_JOBS=2
RATE_LIMIT_API_PER_MINUTE=300
RATE_LIMIT_AUTH_PER_15_MIN=20
RATE_LIMIT_PUSH_PER_15_MIN=20
RATE_LIMIT_FETCH_PER_15_MIN=30
RATE_LIMIT_EDITOR_PER_15_MIN=300
RATE_LIMIT_UPLOAD_PER_15_MIN=10
RATE_LIMIT_AGENT_PER_15_MIN=3

# Time limits in milliseconds (defaults shown). A git call is killed after GIT_TIMEOUT_MS; a push,
# fetch or sync stops issuing git calls after JOB_TIMEOUT_MS; Supabase requests are abandoned after
# SUPABASE_TIMEOUT_MS. All integer settings must be whole numbers or the server will not start.
GIT_TIMEOUT_MS=300000
JOB_TIMEOUT_MS=600000
SUPABASE_TIMEOUT_MS=300000
OPENAI_AGENT_TIMEOUT_MS=900000

# Optional GitHub Pusher coding agent. Keep both values server-side only.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_GITHUB_CREDENTIAL_ID=YOUR_OPENAI_GITHUB_MCP_CREDENTIAL_ID
OPENAI_AGENT_ENVIRONMENT_ID=YOUR_OPENAI_HOSTED_ENVIRONMENT_ID
OPENAI_AGENT_MODEL=gpt-6-sol

# Optional: bounded read-only editor workspace cache (reduces repeated archive restores)
EDITOR_CACHE_TTL_MS=60000
EDITOR_CACHE_MAX_PROJECTS=3
EDITOR_CACHE_MAX_MB=80
