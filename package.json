{
  "name": "github-project-pusher",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env server.js",
    "desktop": "electron electron/main.cjs",
    "build:desktop": "electron-builder --config electron-builder.yml",
    "build:windows-installer": "electron-builder --config electron-builder.yml --win msi",
    "build:android": "node scripts/build-android.mjs",
    "prepare:android": "node scripts/prepare-android.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.57.4",
    "dotenv": "^18.0.7",
    "express": "5.1.0",
    "helmet": "8.1.0",
    "multer": "^2.4.0",
    "tar": "7.5.22"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.5.0",
    "typescript": "~5.0.2"
  },
  "main": "electron/main.cjs",
  "description": "A public-hostable GitHub project library with a static GitHub Pages frontend, a free Render Node backend, and persistent Supabase Postgres + private Storage.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Abhijit251109/GitHub_Pusher-WebApplication.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Abhijit251109/GitHub_Pusher-WebApplication/issues"
  },
  "homepage": "https://github.com/Abhijit251109/GitHub_Pusher-WebApplication#readme",
  "allowScripts": {
    "electron@39.0.0": true,
    "electron-winstaller@5.4.0": true
  }
}
